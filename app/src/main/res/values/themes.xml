<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MoneyTrack.Splash" parent="Theme.SplashScreen">

        <!-- Splash background -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- App icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Optional icon background -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>

        <!-- After splash, switch to main theme -->
        <item name="postSplashScreenTheme">@style/Theme.MoneyTrack</item>

    </style>
</resources>
