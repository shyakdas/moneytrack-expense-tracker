# Root EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin files
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# Ktlint-specific rules
ktlint_standard_no-wildcard-imports = true
ktlint_standard_trailing-comma = enabled
ktlint_standard_filename = enabled

# Compose readability
ktlint_standard_function-naming = enabled
ktlint_standard_property-naming = enabled

# YAML / CI files
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2
